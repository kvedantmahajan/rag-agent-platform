{
  "name": "ai-session-6",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "next dev -p 3001",
    "dev:api": "tsx --tsconfig server/tsconfig.json server/main.ts",
    "dev": "npm run dev:api & npm run dev:web",
    "build:web": "next build",
    "start:web": "next start -p 3001",
    "start:api": "tsx --tsconfig server/tsconfig.json server/main.ts",
    "stop:api": "lsof -ti:3000 | xargs kill 2>/dev/null && echo 'Stopped API on :3000' || echo 'No API on :3000'",
    "step1": "node step1-basic-agent.js",
    "step3": "node step3-langgraph-agent.js",
    "step4": "node step4-human-in-loop.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.8",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.4.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  }
}
