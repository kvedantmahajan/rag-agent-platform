{
  "name": "ai-session-7",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx --tsconfig server/tsconfig.json server/main.ts",
    "dev:web": "next dev -p 3000",
    "dev": "npm run dev:api & npm run dev:web",
    "start:api": "tsx --tsconfig server/tsconfig.json server/main.ts",
    "build:api": "tsc -p server/tsconfig.build.json",
    "build:web": "next build",
    "build": "npm run build:api",
    "start": "node dist/main.js",
    "start:web": "next start -p 3000",
    "stop:api": "lsof -ti:3001 | xargs kill 2>/dev/null && echo 'Stopped API on :3001' || echo 'No API on :3001'",
    "step1": "node server/step1-cached-rag.js",
    "seed:kb": "tsx --tsconfig server/tsconfig.json server/seed-kb.ts",
    "eval": "node server/eval-harness.js",
    "postinstall": "node -e \"import('@xenova/transformers').then(()=>console.log('transformers ok')).catch((e)=>{console.warn(e); process.exit(0)})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.4.0",
    "next": "^15.5.0",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "tsx": "^4.23.1"
  }
}
