# Anthropic — optional (prompt caching demos)
ANTHROPIC_API_KEY=

# Groq — required in production
GROQ_API_KEY=

# Neon pooled URL (…-pooler.…, sslmode=require) — default in .env
# Put local Postgres in .env.local so it overrides this:
#   DATABASE_URL=postgresql://localhost:5432/rag_kb
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXX-pooler.…/neondb?sslmode=require

# Local Nest listen port (Render sets PORT automatically — do not set PORT on Render)
# Matches lib/api.ts default (http://localhost:3001)
API_PORT=3001

# Next.js → Nest (Vercel: set to your Render URL, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS — Vercel frontend origin, no trailing slash
# FRONTEND_URL=https://your-rag-app.vercel.app
