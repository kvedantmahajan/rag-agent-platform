# Shared / cloud placeholders (gitignored `.env` holds real secrets locally).
# Local development: copy values you need into `.env`, then ALWAYS use `.env.local`
# for DATABASE_URL + NEXT_PUBLIC_API_URL so Nest and Next hit localhost Postgres + Nest.

# Anthropic — optional (prompt caching demos)
ANTHROPIC_API_KEY=

# Groq — required for generation (put the real key in gitignored `.env`)
GROQ_API_KEY=

# Cloud / Render Neon pooled URL (placeholder only in this example file)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXX-pooler.…/neondb?sslmode=require

# --- .env.local (create this; gitignored) ---
# DATABASE_URL=postgresql://localhost:5432/rag_kb
# NEXT_PUBLIC_API_URL=http://localhost:3001
# API_PORT=3001
#
# Nest loads `.env` then `.env.local` (override). Next.js does the same for NEXT_PUBLIC_*.
# Vercel: set NEXT_PUBLIC_API_URL to your Render URL in the Vercel dashboard only.

# Langfuse (optional) — set real keys in `.env` (not placeholders in `.env.local`)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
