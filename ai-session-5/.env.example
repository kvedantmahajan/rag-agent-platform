# Production / default — Groq
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_TOOLS=llama-3.3-70b-versatile
GROQ_API_KEY=
DATABASE_URL=postgresql://localhost:5432/rag_kb
API_PORT=3000

# Frontend (also set in Vercel / .env.local for dev)
# Local Session 5 Nest: http://localhost:3000
# Production Session 7 Nest on Render (no trailing slash):
# NEXT_PUBLIC_API_URL=https://rag-agent-platform.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000
