{
  "name": "ai-session-5",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "next dev -p 3001",
    "dev:api": "tsx --tsconfig server/tsconfig.json server/main.ts",
    "dev": "npm run dev:api & npm run dev:web",
    "build:web": "next build",
    "start:web": "next start -p 3001",
    "start:api": "tsx --tsconfig server/tsconfig.json server/main.ts",
    "stop:api": "lsof -ti:3000 | xargs kill 2>/dev/null && echo 'Stopped API on :3000' || echo 'No API on :3000'"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.13",
    "@ai-sdk/react": "^3.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@xenova/transformers": "^2.17.2",
    "ai": "^6.0.0",
    "ai-sdk-ollama": "^3.8.8",
    "dotenv": "^17.4.2",
    "next": "^15.5.0",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  }
}